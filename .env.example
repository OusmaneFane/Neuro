APP_NAME=DoniSanté
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/database/database.sqlite

# PostgreSQL (décommenter si utilisé)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=medipass
# DB_USERNAME=postgres
# DB_PASSWORD=

# MySQL (décommenter si utilisé)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=medipass
# DB_USERNAME=root
# DB_PASSWORD=

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=10080

FILESYSTEM_DISK=public

# Laisser VITE_API_URL vide en local : le front utilisera /api (même origine que la page).
# Vite ne remplace pas ${APP_URL} ; ne pas mettre VITE_API_URL="${APP_URL}/api".
VITE_APP_URL=http://localhost:8000
VITE_API_URL=
